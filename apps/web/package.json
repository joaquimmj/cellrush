    "react-router-dom": "6.28.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.11",
    "vite": "5.4.11"
  }
}
