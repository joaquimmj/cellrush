{
  "name": "cellrush-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@cellrush/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "secrets:scan": "node scripts/scan-secrets.mjs --all",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "db:start": "node scripts/build-edge.mjs && supabase start -x realtime,storage-api,imgproxy,vector,logflare,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "build:edge": "node scripts/build-edge.mjs",
    "db:functions": "node scripts/build-edge.mjs && supabase functions serve",
    "env:local": "node scripts/env-local.mjs",
    "test:db": "pnpm build:edge && pnpm --filter @cellrush/server-tests test:db",
    "media": "node apps/web/scripts/media.mjs && node apps/web/scripts/social.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "supabase": "2.122.0",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild"
    ]
  },
  "license": "AGPL-3.0-only"
}
